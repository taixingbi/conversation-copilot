# Whisper model size: medium | large
WHISPER_MODEL=distil-large

# Audio devices: index or name substring. Empty = default mic / auto-detect loopback.
# List devices:  python main.py --list-devices
AUDIO_DEVICE=C270
EXTERNAL_AUDIO_DEVICE=BlackHole

# Bedrock Function URL (OpenAI-compatible /v1/chat/completions)
# https://github.com/taixingbi/bedrock-tenants
# Paste the Lambda Function URL, e.g. https://xxxx.lambda-url.us-east-1.on.aws/
FUNCTION_URL=https://gwjg7secnplcnrbdxrb52ijbge0dwwnu.lambda-url.us-east-1.on.aws/
INFERENCE_API_KEY=
LLM_MODEL=nova-pro

OVERLAY_THEME=white

RECOGNITION_CONFIDENCE=0.70

# Live question extraction; speaker family EXT includes EXT-1, EXT-2, etc.
# For one-mic diarization, select the other speaker explicitly, e.g. MIC-3.
QA_TARGET_SPEAKERS=EXT
QA_WINDOW_SEC=45
QA_INTERVAL_SEC=1
# Optional smaller model for question extraction:
LLM_FAST_MODEL=

# Streaming transcription: local rolling Whisper when URL is empty.
# Remote endpoint must implement the PCM WebSocket bridge protocol in README.
STT_WS_URL=
STT_WS_TOKEN=
STT_VOCABULARY=Amazon Bedrock,IAM,LangGraph,AWS,Lambda,boto3
STT_CHUNK_SEC=0.4
STT_SILENCE_SEC=0.5
STT_MAX_UTTERANCE_SEC=25
